---
layout: default
---

<div class="projects-sidebar-layout">
  <!-- Sidebar Navigation -->
  <aside class="projects-sidebar">
    <nav class="projects-nav">
      <ul>
        <li class="nav-title"><a href="{{ page.url | relative_url }}" class="active">{{ page.title }}</a></li>
        {% assign sorted_projects = site.projects | where: "category", "work" | sort: "importance" %}
        {% for project in sorted_projects %}
        <li class="project-nav-item">
          <a href="{{ project.url | relative_url }}">{{ project.title }}</a>
        </li>
        {% endfor %}
      </ul>
    </nav>
  </aside>

  <!-- Main Content Area -->
  <main class="projects-main-content">
    <section class="project-covers">
      {% assign sorted_projects = site.projects | where: "category", "work" | sort: "importance" %}
      {% for project in sorted_projects %}
      <a class="project-cover" href="{{ project.url | relative_url }}">
        <div class="cover-image-wrap">
          <div class="cover-image">
            {% if project.img %}
            {% include figure.liquid
              loading="eager"
              path=project.img
              alt=project.title
              class="cover__img"
            %}
            {% endif %}
          </div>
        </div>
        <div class="details-wrap">
          <div class="details">
            <div class="details-inner">
              <div class="title">{{ project.title }}</div>
            </div>
          </div>
        </div>
      </a>
      {% endfor %}
    </section>
  </main>
</div>
